{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm enrich && pnpm build",
  "outputDirectory": "out",
  "rewrites": [
    {
      "source": "/@:user",
      "destination": "/users/:user"
    },
    {
      "source": "/@:user/",
      "destination": "/users/:user/"
    }
  ],
  "headers": [
    {
      "source": "/api/badge/(.*)",
      "headers": [{ "key": "Content-Type", "value": "image/svg+xml; charset=utf-8" }]
    },
    {
      "source": "/pack/(.*)/opengraph-image(.*)",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    },
    {
      "source": "/pack/(.*)/twitter-image(.*)",
      "headers": [{ "key": "Content-Type", "value": "image/png" }]
    }
  ]
}
